APP_NAME="UCM Conferences"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Conference pages run on subdomains: http://ans2027.localhost:8000
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB (R35). Values for the planned Docker / LXC environment; never commit real ones.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ucm_conferences
DB_USERNAME=ucm
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# One login for all conference subdomains needs a shared cookie domain, e.g. .ucm.sk (open: backend address).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# E-mails, invoices and listeners run through the queue: php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mailpit locally (backend.md 2)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="conferences@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Modules (config/modules.php). Invoicing can be switched off (O32).
MODULE_INVOICING_ENABLED=true

# Working value BO2 — 3 failed login attempts, then a lockout (seconds).
LOGIN_MAX_ATTEMPTS=3
LOGIN_DECAY_SECONDS=300

# Submission size limit in KB (BO5)
SUBMISSION_MAX_KB=10240

# Password of the fictional seed accounts (local development only)
SEED_USER_PASSWORD=password
